# Website + privacy-request service (apps/server). All optional.
PORT=3000
# Public URL used in email links (defaults to websiteUrl in business.config.json)
PUBLIC_URL=https://yourdomain.com
# Send real email (requires `npm install nodemailer`); otherwise emails are printed to the console
SMTP_URL=smtps://user:password@smtp.yourprovider.com:465
MAIL_FROM="Crewdeck <support@yourdomain.com>"
# Local data directory when not on Replit
DATA_DIR=./apps/server/data
# Disable Expo CLI developer telemetry
EXPO_NO_TELEMETRY=1
